#!name=Simple Voice Tool
#!desc=本地提供完整语音工具网页；用 Safari/Chrome 打开 https://voice.tool/；须启用 MITM 并信任证书

[Script]
simple-voice-tool = type=http-request,pattern=^https?://voice\.tool(?::(?:80|443))?(?:/|$),script-path=Simple-Voice-Tool.js,requires-body=false,binary-body-mode=true,timeout=30

[MITM]
hostname = %APPEND% voice.tool

[Host]
voice.tool = 192.0.2.1
